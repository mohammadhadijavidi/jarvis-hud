# Jarvis HUD backend configuration. Copy to .env and fill in what you use.

# --- Agent backend (`npm run serve`) ---
# mock | openai | openrouter | groq | ollama | lmstudio | openai-compatible | anthropic
JARVIS_PROVIDER=mock
# Optional overrides (each provider has a sensible default model / base URL)
JARVIS_MODEL=
JARVIS_BASE_URL=
# Generic key; or use the provider-specific variables below
JARVIS_API_KEY=
JARVIS_TEMPERATURE=
JARVIS_SYSTEM_PROMPT=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenAI Realtime relay (`npm run relay`) uses OPENAI_API_KEY ---
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# --- Server ---
PORT=8787
HOST=127.0.0.1

# --- Frontend (build time) ---
# Point a statically hosted HUD at a backend. Can also be set per page with ?ws=
VITE_JARVIS_WS_URL=
